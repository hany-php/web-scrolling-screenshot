#!/usr/bin/env sh
set -e

MSG_FILE="$1"
FIRST_LINE=$(head -n 1 "$MSG_FILE")

if ! echo "$FIRST_LINE" | grep -qE '^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9-]+\))?: .+'; then
  echo "Error: Commit message must follow Conventional Commits (e.g. 'feat: add scroll planner')." >&2
  exit 1
fi
